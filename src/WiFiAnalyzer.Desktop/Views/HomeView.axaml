<views:ActivatableView xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:vm="using:WiFiAnalyzer.Core.ViewModels.Network"
                       xmlns:views="using:WiFiAnalyzer.Desktop.Views"
                       xmlns:controls="using:WiFiAnalyzer.Desktop.Views.Controls"
                       x:Class="WiFiAnalyzer.Desktop.Views.HomeView"
                       x:DataType="vm:MainPageViewModel">
    <Grid ColumnDefinitions="*,*">
        <controls:NetworkDetailsView HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                       IsVisible="{Binding DownloadSpeed, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding DownloadSpeed.MegabitsPerSecond, StringFormat='Speed: {0:F2} Mb/s'}" />
            <Button Content="Speed" Command="{Binding GetDownloadSpeedCommand}"
                    Width="150" Height="150" CornerRadius="80" FontSize="22"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="150" />
        </StackPanel>
    </Grid>
</views:ActivatableView>
