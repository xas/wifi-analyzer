<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiFiAnalyzer.Core.ViewModels.Networks"
             xmlns:views="using:WiFiAnalyzer.Desktop.Views"
             x:Class="WiFiAnalyzer.Desktop.Views.NetworksPageView"
             x:DataType="vm:NetworksPageViewModel">
    <DockPanel>
        <Button DockPanel.Dock="Top" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}"
                Width="150" HorizontalContentAlignment="Center" />

        <ContentControl Content="{Binding Current}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:NetworksTableViewModel">
                    <views:NetworksTableView />
                </DataTemplate>
                <DataTemplate DataType="vm:NetworksGraphViewModel">
                    <views:NetworksGraphView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</UserControl>
